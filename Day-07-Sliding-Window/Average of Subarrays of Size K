arr = [1, 2, 3, 4, 5]
k = 3

# First window
total = 0

for i in range(k):
    total += arr[i]

average = total / k
print(f"The average will be {average}")

# Slide the window
for i in range(k, len(arr)):
    total = total - arr[i-k] + arr[i]

    average = total / k
    print(f"The average will be {average}")
